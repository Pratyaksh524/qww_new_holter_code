# CardioX / RhythmUltra — environment template
#
# Copy to `.env` and fill in the blanks:   cp .env.example .env
# `.env` is gitignored and must never be committed. Ask a maintainer for the
# real values; do not paste them into chat, tickets or PRs.
#
# Every key the application actually reads is listed here. Blank values are
# optional; keys marked REQUIRED must be set for the app to run properly.


# ── Licence server ───────────────────────────────────────────────────────────
# Defaults to the production gateway if unset, so this is optional for most
# work. Point it at a local server to develop against license_server/server.py.
LICENSE_SERVER_URL=https://m4qoae4d8e.execute-api.us-east-1.amazonaws.com/prod/api/v1

# NOTE: LICENSE_API_TOKEN and LICENSE_HMAC_SECRET are deliberately absent.
# The desktop client does not need them — /api/v1/* accepts requests without an
# API key, and the server does not verify the client's request signature.
# LICENSE_API_TOKEN is an ADMIN credential granting /admin/licenses,
# /admin/create and /admin/revoke; it must never ship to a machine that only
# runs the app. build_exe.py strips both from the distributed .env.


# ── Development flags ────────────────────────────────────────────────────────
# Auto-login as the 'cardiomac' test account, skipping BOTH the password prompt
# and the licence gate (heartbeat, revocation, offline grace). Local dev only.
# Requires a 'cardiomac' record in users.json. Never set in a build — the value
# is stripped from the installer by build_exe.py.
CARDIOX_DEV_AUTOLOGIN=

# Force the RhythmUltra USB presence check back on.
CARDIOX_REQUIRE_RHYTHMULTRA=

# Verbose licence diagnostics.
CARDIOX_LICENSE_DEBUG=


# ── Cloud upload (S3) ────────────────────────────────────────────────────────
# REQUIRED if CLOUD_UPLOAD_ENABLED=true, otherwise report sync fails silently.
CLOUD_UPLOAD_ENABLED=false
CLOUD_SERVICE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
S3_REPORTS_PREFIX=


# ── Doctor review / reports API ──────────────────────────────────────────────
DOCTOR_REVIEW_ENABLED=false
DOCTOR_REVIEW_API_URL=
DOCTOR_REVIEW_API_KEY=
DOCTOR_UPLOAD_API_URL=
DOCTOR_UPLOAD_API_KEY=
REVIEWED_REPORTS_API_URL=
REVIEWED_REPORTS_API_KEY=
PUBLIC_API_KEY=


# ── Chatbot ──────────────────────────────────────────────────────────────────
CHATBOT_API_URL=
CHATBOT_API_KEY=
CHATBOT_MODEL=
GROQ_API_KEY=


# ── Crash-report email (optional) ────────────────────────────────────────────
# Left blank the app logs a warning at startup and carries on.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=


# ── Updates ──────────────────────────────────────────────────────────────────
ECG_UPDATE_CHANNEL=
ECG_UPDATE_REPO=
